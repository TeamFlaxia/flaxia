/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Content-Security-Policy is emitted by SvelteKit (vite.config.ts `csp`) so
# hashes match the rendered inline scripts. A static header here would
# intersect with that policy and block the hashed bootstrap scripts.


# Export popup only: cross-origin isolation for the multithreaded ffmpeg core.
# Deliberately NOT site-wide — COEP would break third-party iframes and images.
/export-popup.html
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# Pinned Crowd browser-node bundle (copied by the Vite build). Path contains
# the version (v0.10.0-0), so it is safe to cache forever.
/crowd/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/assets/*.js
  Content-Type: application/javascript

# Ad network MIME type fixes
/AdServer/js/*.js
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/AdServer/*.js
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/usync.js
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/async_usersync
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff

/showad.js
  Content-Type: application/javascript
  X-Content-Type-Options: nosniff
