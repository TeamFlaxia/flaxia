# Cloudflare Account ID for R2 public URLs
# Get this from your Cloudflare dashboard
VITE_CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Stripe (billing). For local dev put these in .dev.vars instead:
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_PRICE_FLXIA_PLUS=price_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FLXIA_PLUS=

# File scan container images (full HTTPS URLs; bare filenames are rejected by
# the browser node).
FILE_SCAN_CLAMAV_IMAGE=
FILE_SCAN_VIDEO_PHASH_IMAGE=
